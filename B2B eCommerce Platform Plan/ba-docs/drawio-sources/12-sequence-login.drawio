    <mxCell id="p_api" value="&lt;b&gt;AuthController&lt;/b&gt;&#xa;(Spring Boot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="270" y="52" width="160" height="50" as="geometry"/></mxCell>

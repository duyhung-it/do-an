    <!-- 11: Store in localStorage -->
    <mxCell id="m11" value="Lưu token vào localStorage" style="text;html=1;align=left;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="50" y="510" width="220" height="18" as="geometry"/></mxCell>

    <!-- Note box: 401 Unauthorized case -->
    <mxCell id="note1" value="&lt;b&gt;[alt] Sai mật khẩu&lt;/b&gt;&#xa;→ 401 Unauthorized: &quot;Email hoặc mật khẩu không đúng&quot;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Times New Roman;align=left;" vertex="1" parent="1"><mxGeometry x="55" y="545" width="350" height="50" as="geometry"/></mxCell>


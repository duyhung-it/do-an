    <!-- ── Messages ── -->
    <!-- 1: POST /auth/login {email, password} -->
    <mxCell id="m1" value="POST /api/auth/login {email, password}" style="text;html=1;align=left;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="120" y="125" width="225" height="18" as="geometry"/></mxCell>
    <mxCell id="e_m1" style="endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="143" as="sourcePoint"/><mxPoint x="350" y="143" as="targetPoint"/></mxGeometry></mxCell>

    <!-- 2: Validate request format -->
    <mxCell id="m2" value="validate(request)" style="text;html=1;align=left;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="355" y="168" width="230" height="18" as="geometry"/></mxCell>
    <mxCell id="e_m2" style="endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="186" as="sourcePoint"/><mxPoint x="590" y="186" as="targetPoint"/></mxGeometry></mxCell>

    <!-- 3: findByEmail -->
    <mxCell id="m3" value="findByEmail(email)" style="text;html=1;align=left;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="595" y="211" width="210" height="18" as="geometry"/></mxCell>
    <mxCell id="e_m3" style="endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="229" as="sourcePoint"/><mxPoint x="810" y="229" as="targetPoint"/></mxGeometry></mxCell>

    <!-- 4: return User -->
    <mxCell id="m4" value="User entity" style="text;html=1;align=right;fontSize=11;fontFamily=Times New Roman;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="595" y="249" width="210" height="18" as="geometry"/></mxCell>
    <mxCell id="e_m4" style="endArrow=open;endFill=0;strokeWidth=1.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="267" as="sourcePoint"/><mxPoint x="590" y="267" as="targetPoint"/></mxGeometry></mxCell>

    <!-- 5: BCrypt verify password -->
    <mxCell id="m5" value="BCrypt.verify(password, hash)" style="text;html=1;align=left;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="355" y="285" width="230" height="18" as="geometry"/></mxCell>
    <mxCell id="e_m5" style="endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="303" as="sourcePoint"/><mxPoint x="590" y="303" as="targetPoint"/></mxGeometry></mxCell>

    <!-- 6: Generate JWT tokens -->
    <mxCell id="m6" value="generateTokens(userId, roles)" style="text;html=1;align=left;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="355" y="323" width="230" height="18" as="geometry"/></mxCell>
    <mxCell id="e_m6" style="endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="341" as="sourcePoint"/><mxPoint x="590" y="341" as="targetPoint"/></mxGeometry></mxCell>

    <!-- 7: Store refresh token in Redis -->
    <mxCell id="m7" value="SET refresh:{userId} → token (TTL 7d)" style="text;html=1;align=left;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="595" y="361" width="310" height="18" as="geometry"/></mxCell>
    <mxCell id="e_m7" style="endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="379" as="sourcePoint"/><mxPoint x="910" y="379" as="targetPoint"/></mxGeometry></mxCell>

    <!-- 8: OK -->
    <mxCell id="m8" value="OK" style="text;html=1;align=right;fontSize=11;fontFamily=Times New Roman;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="595" y="399" width="310" height="18" as="geometry"/></mxCell>
    <mxCell id="e_m8" style="endArrow=open;endFill=0;strokeWidth=1.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="417" as="sourcePoint"/><mxPoint x="590" y="417" as="targetPoint"/></mxGeometry></mxCell>

    <!-- 9: Return tokens to controller -->
    <mxCell id="m9" value="{accessToken (RS256, 1h), refreshToken}" style="text;html=1;align=right;fontSize=11;fontFamily=Times New Roman;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="355" y="437" width="230" height="18" as="geometry"/></mxCell>

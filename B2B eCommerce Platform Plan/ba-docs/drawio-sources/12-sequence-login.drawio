    <!-- 10: 200 OK Response -->
    <mxCell id="m10" value="200 OK: {accessToken, refreshToken, user}" style="text;html=1;align=right;fontSize=11;fontFamily=Times New Roman;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="120" y="475" width="225" height="18" as="geometry"/></mxCell>
